<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Plugin.ThemeKit.WinUI.Sample.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Plugin.ThemeKit.WinUI.Sample"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Plugin.ThemeKit.WinUI.Sample"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <!-- Title Bar-->
            <RowDefinition Height="Auto" />
            <!-- App Content -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar"
                  Title="Plugin.ThemeKit.WinUI.Sample"
                  BackRequested="TitleBar_BackRequested"
                  IsBackButtonVisible="{x:Bind rootFrame.CanGoBack, Mode=OneWay}"
                  PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.Resources>
                <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
            </TitleBar.Resources>
        </TitleBar>

        <NavigationView x:Name="navBar"
                        Grid.Row="1"
                        Canvas.ZIndex="0"
                        x:FieldModifier="public"
                        DisplayModeChanged="OnPaneDisplayModeChanged"
                        OpenPaneLength="300"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        IsTabStop="False"
                        SelectionChanged="NavBar_SelectionChanged">
            <NavigationView.MenuItems>

                <!-- Pages-->
                <NavigationViewItem x:Name="Home"
                                    AutomationProperties.AutomationId="Home"
                                    Content="Home"
                                    Tag="MainPage">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

            </NavigationView.MenuItems>

            <!-- App Content -->
            <Frame x:Name="rootFrame" />

        </NavigationView>
        
    </Grid>
    
</Window>
